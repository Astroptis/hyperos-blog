{
  "name": "hyperos-blog-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "routes": [
    { "pattern": "api.astroptis.dpdns.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyperos-blog",
      "database_id": "f5c2bb13-f5ef-4c56-b2fd-f3cd75054493"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "01de5cce298d4f5f8f88ce78c07d5f37"
    }
  ]
}